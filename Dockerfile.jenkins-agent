FROM python:3.11-slim

# Install Docker CLI + curl
RUN apt-get update && \
    apt-get install -y docker.io curl git && \
    apt-get clean

# Install Docker Compose v2 manually
RUN curl -SL https://github.com/docker/compose/releases/download/v2.29.2/docker-compose-linux-x86_64 \
    -o /usr/local/bin/docker-compose && \
    chmod +x /usr/local/bin/docker-compose

# Make "docker compose" work
RUN mkdir -p /usr/libexec/docker/cli-plugins && \
    ln -s /usr/local/bin/docker-compose /usr/libexec/docker/cli-plugins/docker-compose
